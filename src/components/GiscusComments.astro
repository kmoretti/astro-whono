---
import { getThemeSettings } from '../lib/theme-settings';

interface Props {
  title?: string;
}

const { title = '评论' } = Astro.props;
const { settings } = getThemeSettings();
const comments = settings.comments;
const getComments = () => {
  if (!comments.enabled) return null;
  return comments;
};
const commentsConfig = getComments();
---

{commentsConfig && <section
  class="giscus-comments"
  data-giscus-comments
  data-repo={comments.repo}
  data-repo-id={comments.repoId}
  data-category={comments.category}
  data-category-id={comments.categoryId}
  data-mapping={comments.mapping}
  data-input-position={comments.inputPosition}
  data-lang={comments.lang}
  data-reactions-enabled={String(Number(comments.reactionsEnabled))}
  data-strict={String(Number(comments.strict))}
  aria-label={title}
>
  <h2 class="giscus-comments__title">{title}</h2>
  <div class="giscus-comments__frame"></div>
  <noscript><p class="giscus-comments__noscript">需要启用 JavaScript 才能查看评论。</p></noscript>
</section>}

<style>
  .giscus-comments {
    margin-top: 36px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }

  .giscus-comments__title {
    margin: 0 0 14px;
    font-family: var(--font-readable);
    font-size: 17px;
    line-height: 1.4;
    color: var(--text);
  }

  .giscus-comments__noscript {
    margin: 0;
    color: var(--muted);
  }

  .giscus-comments__frame {
    /* 宽度 100% 确保 iframe 撑满容器 */
    width: 100%;
    /* 最小占位高度，避免加载前布局跳动 */
    min-height: 300px;
  }

  /* giscus iframe 由 giscus 客户端 script 注入，用 :global 选择器穿透 scoped style */
  :global(.giscus-frame) {
    width: 100% !important;
    border: 0;
    display: block;
    /* giscus 在 SPA 客服端脚本切换后 iframe 高度可能被低估，设置兜底高度避免过度挤压 */
    min-height: 420px;
  }
</style>
