---
import AdminHelpTip from './AdminHelpTip.astro';
import AdminIcon from './AdminIcon.astro';
import UiIcon from '../UiIcon.astro';
import { ADMIN_NAV_ORNAMENT_DEFAULT, ADMIN_SIDEBAR_DIVIDER_OPTIONS } from '../../lib/admin-console/theme-shared';
---

<fieldset class="admin-group">
  <legend class="admin-group__legend">
    <AdminIcon name="admin-sidebar" class="admin-group__legend-icon" size={14} />
    <span class="admin-group__legend-copy">
      <span class="admin-group__legend-zh">侧栏设置</span>
      <span class="admin-group__legend-en">Sidebar</span>
    </span>
  </legend>
  <div class="admin-sidebar-layout">
    <div class="admin-sidebar-layout__main">
      <label class="admin-field">
        <span class="admin-label">
          <span class="admin-label__main">侧栏站点名</span>
          <span class="admin-label__hint">（显示在左侧站点标题）</span>
        </span>
        <input class="admin-field__control" id="shell-brand-title" type="text" autocomplete="off" />
      </label>
      <label class="admin-field">
        <span class="admin-label">
          <span class="admin-label__main">侧栏引用文案</span>
          <span class="admin-label__hint">（支持换行显示）</span>
        </span>
        <textarea class="admin-field__control" id="shell-quote" rows="4"></textarea>
      </label>
      <div class="admin-field admin-field--sidebar-divider">
        <span class="admin-label">
          <span class="admin-label__main">侧栏分隔线</span>
          <span class="admin-label__hint">（控制与正文间的分隔强度）</span>
        </span>
        <div class="admin-segmented" role="radiogroup" aria-label="侧栏分隔线样式">
          {
            ADMIN_SIDEBAR_DIVIDER_OPTIONS.map((option) => (
              <label class="admin-segmented__option" for={`ui-layout-sidebar-divider-${option.id}`}>
                <input
                  id={`ui-layout-sidebar-divider-${option.id}`}
                  name="ui-layout-sidebar-divider"
                  type="radio"
                  value={option.id}
                  checked={option.id === 'default'}
                />
                <span>{option.label}</span>
              </label>
            ))
          }
        </div>
      </div>

      <div class="admin-subgroup admin-subgroup--sidebar-icons">
        <p class="admin-subtitle">
          <span class="admin-subtitle__main">侧栏图标</span>
          <span class="admin-subtitle__hint">（选择底部显示的图标）</span>
        </p>
        <div class="admin-sidebar-icon-grid" role="group" aria-label="侧栏图标显隐">
          <label class="admin-sidebar-icon-toggle" for="ui-reading-entry" title="显示阅读模式入口">
            <input id="ui-reading-entry" type="checkbox" aria-label="显示阅读模式入口" title="显示阅读模式入口" />
            <span
              class="admin-btn admin-btn--tool admin-btn--compact admin-btn--icon admin-sidebar-icon-toggle__button"
              aria-hidden="true"
            >
              <UiIcon name="book-open" size={18} strokeWidth={2} />
            </span>
          </label>
          <label class="admin-sidebar-icon-toggle" for="ui-sidebar-actions-show-rss-link" title="显示 RSS 入口">
            <input
              id="ui-sidebar-actions-show-rss-link"
              type="checkbox"
              aria-label="显示 RSS 入口"
              title="显示 RSS 入口"
            />
            <span
              class="admin-btn admin-btn--tool admin-btn--compact admin-btn--icon admin-sidebar-icon-toggle__button"
              aria-hidden="true"
            >
              <UiIcon name="rss" size={18} strokeWidth={2} />
            </span>
          </label>
          <label class="admin-sidebar-icon-toggle" for="ui-sidebar-actions-show-theme-toggle" title="显示主题切换入口">
            <input
              id="ui-sidebar-actions-show-theme-toggle"
              type="checkbox"
              aria-label="显示主题切换入口"
              title="显示主题切换入口"
            />
            <span
              class="admin-btn admin-btn--tool admin-btn--compact admin-btn--icon admin-sidebar-icon-toggle__button"
              aria-hidden="true"
            >
              <UiIcon name="moon" size={17} strokeWidth={2} />
            </span>
          </label>
          <label
            id="ui-sidebar-actions-show-admin-entry-row"
            class="admin-sidebar-icon-toggle"
            for="ui-sidebar-actions-show-admin-entry"
            title="显示站点概览入口（/admin/）"
          >
            <input
              id="ui-sidebar-actions-show-admin-entry"
              type="checkbox"
              aria-label="显示 /admin/ 入口"
              title="显示站点概览入口（/admin/）"
            />
            <span
              class="admin-btn admin-btn--tool admin-btn--compact admin-btn--icon admin-sidebar-icon-toggle__button"
              aria-hidden="true"
            >
              <UiIcon name="monitor-dot" size={18} strokeWidth={2} />
            </span>
          </label>
        </div>
      </div>
    </div>

    <div class="admin-subgroup admin-subgroup--sidebar-nav">
      <p class="admin-subtitle">
        <span class="admin-subtitle__main">侧栏导航</span>
        <AdminHelpTip
          id="admin-nav-ornament-hint"
          label="侧栏导航后缀说明"
          text={`后缀支持短文本/符号；留空隐藏，输入 ${ADMIN_NAV_ORNAMENT_DEFAULT} 还原默认。拖拽 ≡ 手柄调整顺序，子导航可拖入其他分组。`}
        />
      </p>
      <div id="shell-nav-editor" class="admin-nav-editor" data-nav-editor></div>
      <div class="admin-nav-editor__foot">
        <button id="shell-nav-add" class="admin-btn admin-btn--ghost admin-btn--compact" type="button">
          添加一级导航
        </button>
      </div>
    </div>
  </div>
</fieldset>
