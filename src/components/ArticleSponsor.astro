---
import UiIcon from './UiIcon.astro';

interface Props {
  className?: string;
}

const { className = '' } = Astro.props as Props;
const sponsorUrl = 'https://sponsor.081531.xyz/';
---

<div class:list={['article-sponsor', className]} role="region" aria-label="赞助">
  <a
    class="article-sponsor__link"
    href={sponsorUrl}
    target="_blank"
    rel="noreferrer noopener"
    title="赞助作者"
  >
    <span class="article-sponsor__label">请作者喝杯咖啡</span>
    <span class="article-sponsor__label-mobile">赞助</span>
    <UiIcon class="article-sponsor__icon" name="heart" ariaLabel="赞助作者" />
  </a>
</div>